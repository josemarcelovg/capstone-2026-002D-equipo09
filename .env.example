# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.
# Dónde obtenerlos: docs/fase2-desarrollo/JOS-02_Configuracion_Base_de_Datos.md

# Supabase > Connect > ORMs > Prisma.
# Conexión de la aplicación: transaction pooler (puerto 6543), con ?pgbouncer=true al final.
DATABASE_URL="postgresql://postgres.[ID-DEL-PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión para migraciones y seed: session pooler (puerto 5432).
DIRECT_URL="postgresql://postgres.[ID-DEL-PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth (SIM-02).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
