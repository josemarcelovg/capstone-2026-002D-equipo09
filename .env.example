# Copia este archivo como .env y completa los valores. El .env nunca se sube al repositorio.
# Dónde obtenerlos: Fase 2/Evidencias Proyecto/Evidencias de documentación/JOS-02_Configuracion_Base_de_Datos.md

# Supabase > Connect > ORMs > Prisma.
# Conexión de la aplicación: transaction pooler (puerto 6543), con ?pgbouncer=true al final.
DATABASE_URL="postgresql://postgres.[ID-DEL-PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión para migraciones y seed: session pooler (puerto 5432).
DIRECT_URL="postgresql://postgres.[ID-DEL-PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Alternativa sin Supabase: la base de datos local de Docker (docker/compose.yaml).
# Con `docker compose -f docker/compose.yaml up db` levantada, reemplazar las dos de arriba por:
# DATABASE_URL="postgresql://micrologist:micrologist@localhost:5432/micrologist"
# DIRECT_URL="postgresql://micrologist:micrologist@localhost:5432/micrologist"
# (Docker completo no necesita este archivo: compose.yaml ya define sus variables.)

# Solo desarrollo, hasta que exista el inicio de sesión (SIM-02): empresa con la que
# se trabaja en las pantallas. Valores del seed: Empresa A ...0001, Empresa B ...0002.
# Cambiarla y reiniciar `npm run dev` sirve para probar la separación entre empresas.
EMPRESA_DESARROLLO_ID="a0000000-0000-4000-8000-000000000001"

# Supabase Auth (SIM-02).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
