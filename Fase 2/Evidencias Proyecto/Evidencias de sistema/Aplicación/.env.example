# Copia este archivo como .env, en esta misma carpeta («Aplicación»), y completa los valores.
# El .env nunca se sube al repositorio.
# Dónde obtenerlos: Fase 2/Evidencias Proyecto/Evidencias de documentación/JOS-02_Configuracion_Base_de_Datos.md

# Supabase > Connect > ORMs > Prisma.
# Conexión de la aplicación: transaction pooler (puerto 6543), con ?pgbouncer=true al final.
DATABASE_URL="postgresql://postgres.[ID-DEL-PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexión para migraciones y seed: session pooler (puerto 5432).
DIRECT_URL="postgresql://postgres.[ID-DEL-PROYECTO]:[CONTRASEÑA]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Alternativa sin Supabase: la base de datos local de Docker (compose.yaml, en esta carpeta).
# Con `docker compose up db` levantada, reemplazar las dos de arriba por:
# DATABASE_URL="postgresql://micrologist:micrologist@localhost:5432/micrologist"
# DIRECT_URL="postgresql://micrologist:micrologist@localhost:5432/micrologist"
# (Docker completo no necesita este archivo: compose.yaml ya define sus variables.
# Si existe, solo toma de aquí EMPRESA_DESARROLLO_ID y los puertos opcionales.)

# Supabase Auth (SIM-02): Supabase > Project Settings > API (Project URL y anon public key).
# Con las dos completas, la aplicación pide iniciar sesión, también en desarrollo.
# Si se completa solo una, la aplicación falla a propósito para no saltarse el inicio de sesión.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo desarrollo y solo si las dos de arriba están vacías (por ejemplo, en Docker):
# se entra sin iniciar sesión, con esta empresa. Valores del seed: Empresa A ...0001,
# Empresa B ...0002. Cambiarla y reiniciar `npm run dev` sirve para probar la separación
# entre empresas. En producción nunca se usa.
EMPRESA_DESARROLLO_ID="a0000000-0000-4000-8000-000000000001"
