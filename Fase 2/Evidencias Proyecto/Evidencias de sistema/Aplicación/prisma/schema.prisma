// Modelo de datos de MicroLogist. En el código los campos van en camelCase y en la base en snake_case.

// Las migraciones están en la carpeta «Base de datos» (ver prisma.config.ts).
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  admin

  @@map("rol")
}

enum TipoVehiculo {
  bus
  minibus
  van
  furgon
  automovil
  otro

  @@map("tipo_vehiculo")
}

enum EstadoVehiculo {
  activo
  en_mantencion
  inactivo

  @@map("estado_vehiculo")
}

enum TipoDocumento {
  revision_tecnica
  soap
  permiso_circulacion
  licencia_conducir
  otro

  @@map("tipo_documento")
}

enum EstadoAviso {
  enviado
  fallido

  @@map("estado_aviso")
}

/// Todos los datos pertenecen a una empresa.
model Empresa {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @db.VarChar(100)
  /// Opcional, pero no se puede repetir entre empresas.
  rut           String?  @unique @db.VarChar(12)
  /// Recibe los avisos de vencimiento.
  emailContacto String   @map("email_contacto") @db.VarChar(254)
  telefono      String?  @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  usuarios    Usuario[]
  vehiculos   Vehiculo[]
  conductores Conductor[]
  documentos  Documento[]
  avisos      AvisoEnviado[]

  @@map("empresa")
}

/// Perfil del usuario. La contraseña la guarda Supabase Auth, no esta tabla.
model Usuario {
  /// Mismo id que el usuario en Supabase Auth.
  id        String   @id @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nombre    String   @db.VarChar(100)
  email     String   @unique @db.VarChar(254)
  rol       Rol      @default(admin)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@map("usuario")
}

model Vehiculo {
  id                 String         @id @default(uuid()) @db.Uuid
  empresaId          String         @map("empresa_id") @db.Uuid
  /// Sin espacios ni guiones: BBCD12 o AB1234.
  patente            String         @db.VarChar(6)
  tipo               TipoVehiculo
  marca              String         @db.VarChar(50)
  modelo             String         @db.VarChar(50)
  anio               Int            @db.SmallInt
  capacidadPasajeros Int            @map("capacidad_pasajeros") @db.SmallInt
  numeroInterno      String?        @map("numero_interno") @db.VarChar(20)
  color              String?        @db.VarChar(30)
  estado             EstadoVehiculo @default(activo)
  observaciones      String?        @db.VarChar(500)
  /// Conductor habitual del vehículo (opcional).
  conductorId        String?        @map("conductor_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  /// El conductor tiene que ser de la misma empresa.
  conductor  Conductor?  @relation(fields: [conductorId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  documentos Documento[]

  /// La patente no se repite dentro de una empresa, pero otra empresa sí puede tenerla.
  @@unique([empresaId, patente])
  @@index([conductorId])
  @@unique([id, empresaId])
  @@map("vehiculo")
}

/// El conductor es un registro, no inicia sesión.
model Conductor {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nombre    String   @db.VarChar(100)
  /// Formato 12345678-9.
  rut       String   @db.VarChar(10)
  /// Formato +56 y 9 dígitos.
  telefono  String   @db.VarChar(12)
  email     String?  @db.VarChar(254)
  /// No se borra: se desactiva.
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  empresa            Empresa     @relation(fields: [empresaId], references: [id])
  documentos         Documento[]
  vehiculosAsignados Vehiculo[]

  /// El RUT no se repite dentro de una empresa, pero otra empresa sí puede tenerlo.
  @@unique([empresaId, rut])
  @@unique([id, empresaId])
  @@map("conductor")
}

/// Pertenece a un vehículo o a un conductor, nunca a los dos. El estado no se guarda: se calcula
/// con la fecha de vencimiento. Renovar un documento es editar su fecha.
model Documento {
  id               String        @id @default(uuid()) @db.Uuid
  empresaId        String        @map("empresa_id") @db.Uuid
  tipo             TipoDocumento
  /// Obligatoria si el tipo es "otro".
  descripcion      String?       @db.VarChar(100)
  vehiculoId       String?       @map("vehiculo_id") @db.Uuid
  conductorId      String?       @map("conductor_id") @db.Uuid
  /// Último día válido.
  fechaVencimiento DateTime      @map("fecha_vencimiento") @db.Date
  observaciones    String?       @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  empresa   Empresa        @relation(fields: [empresaId], references: [id])
  /// El dueño tiene que ser de la misma empresa.
  vehiculo  Vehiculo?      @relation(fields: [vehiculoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  conductor Conductor?     @relation(fields: [conductorId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  avisos    AvisoEnviado[]

  /// Un vehículo o conductor tiene uno solo de cada tipo, salvo "otro".
  @@unique([vehiculoId, tipo], map: "documento_vehiculo_id_tipo_key", where: raw("tipo <> 'otro'"))
  @@unique([conductorId, tipo], map: "documento_conductor_id_tipo_key", where: raw("tipo <> 'otro'"))
  @@unique([id, empresaId])
  @@index([empresaId, fechaVencimiento])
  @@index([vehiculoId])
  @@index([conductorId])
  @@map("documento")
}

/// Registro de los avisos enviados, para no mandar dos veces el mismo.
model AvisoEnviado {
  id               String      @id @default(uuid()) @db.Uuid
  empresaId        String      @map("empresa_id") @db.Uuid
  documentoId      String      @map("documento_id") @db.Uuid
  /// Si el documento se renueva, sus avisos empiezan de cero.
  fechaVencimiento DateTime    @map("fecha_vencimiento") @db.Date
  /// 30, 7, 1 o 0 días antes del vencimiento.
  diasAnticipacion Int         @map("dias_anticipacion") @db.SmallInt
  destinatario     String      @db.VarChar(254)
  estado           EstadoAviso
  /// Último intento de envío.
  enviadoEn        DateTime    @map("enviado_en") @db.Timestamptz

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  documento Documento @relation(fields: [documentoId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([documentoId, fechaVencimiento, diasAnticipacion])
  @@index([empresaId])
  @@map("aviso_enviado")
}
